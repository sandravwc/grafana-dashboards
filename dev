#!/bin/sh
# Save gen.py or topology.py: regenerates topology.png + poco.json, copies json to the phone. Live in ~10 s, reload the tab.
# No commit. Ctrl-C to stop. When happy: git commit -am ... && git push (push deploys too, see deploy/post-receive).
cd "$(dirname "$0")"
PY=.venv/bin/python; [ -x $PY ] || PY=python3
last=
while sleep 1; do
    m=$(stat -c %Y gen.py topology.py | tr '\n' ' ') && [ "$m" != "$last" ] || continue
    last=$m
    $PY topology.py 2>/dev/null && $PY gen.py && scp -q poco.json poco_f5_pro-phone-hyperos:monitoring/dashboards/poco.json && echo "live $(date +%T)"
done
