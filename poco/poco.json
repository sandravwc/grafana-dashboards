    {
     "refId": "u3",
     "expr": "haproxy_up",
     "legendFormat": "haproxy",
     "instant": true,
     "range": false
    },
    {
     "refId": "r3",
     "expr": "sum(rate(haproxy_backend_sessions_total[5m])) * 60",
     "legendFormat": "haproxy rpm",
     "instant": true,
     "range": false
    },
    {
     "refId": "u4",
     "expr": "haproxy_backend_up{backend=\"grafana\"}",
     "legendFormat": "grafana",
     "instant": true,
     "range": false
    },
    {
     "refId": "r4",
     "expr": "rate(haproxy_backend_sessions_total{backend=\"grafana\"}[5m]) * 60",
     "legendFormat": "grafana rpm",
     "instant": true,
     "range": false
    },
    {
     "refId": "u5",
     "expr": "probe_success{name=\"sshd\"}",
     "legendFormat": "sshd",
     "instant": true,
     "range": false
    },
    {
     "refId": "u6",
     "expr": "up{job=\"anubis\", app=\"mealprep\"}",
