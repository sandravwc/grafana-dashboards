    "y": 13,
    "w": 24,
    "h": 14
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "u0",
     "expr": "haproxy_backend_up{backend=\"alerts\"}",
     "legendFormat": "alerts",
     "instant": true,
     "range": false
    },
    {
     "refId": "r0",
     "expr": "rate(haproxy_backend_sessions_total{backend=\"alerts\"}[5m]) * 60",
     "legendFormat": "alerts rpm",
     "instant": true,
     "range": false
    },
    {
     "refId": "u1",
     "expr": "up{job=\"prometheus\"}",
     "legendFormat": "prom",
     "instant": true,
     "range": false
    },
    {
     "refId": "r1",
     "expr": "rate(haproxy_backend_sessions_total{backend=\"prom\"}[5m]) * 60",
