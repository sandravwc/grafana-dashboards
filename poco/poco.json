{
 "uid": "poco",
 "title": "poco",
 "timezone": "browser",
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "schemaVersion": 39,
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "overview",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "probes",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 24,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "probe_success",
     "legendFormat": "{{name}}",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red"
        },
        "1": {
         "text": "UP",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name",
    "justifyMode": "center",
    "text": {
     "titleSize": 18,
     "valueSize": 34
    }
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "cert days left",
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 12,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "min((probe_ssl_earliest_cert_expiry - time()) / 86400)",
     "legendFormat": "wildcard",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 3
       },
       {
        "color": "green",
        "value": 30
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name",
    "justifyMode": "center",
    "text": {
     "titleSize": 18,
     "valueSize": 34
    }
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "firing",
   "gridPos": {
    "x": 12,
    "y": 7,
    "w": 12,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(ALERTS{alertstate=\"firing\", alertname!=\"Watchdog\"}) or vector(0)",
     "legendFormat": "alerts",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name",
    "justifyMode": "center",
    "text": {
     "titleSize": 18,
     "valueSize": 34
    }
   }
  },
  {
   "id": 5,
   "type": "row",
   "title": "service graph",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 6,
   "type": "canvas",
